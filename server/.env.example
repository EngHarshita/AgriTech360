# ==============================================================================
# AgriTech360 - Server Environment Variables
# ==============================================================================
# Copy this file to .env in the server/ directory:
#   cp .env.example .env
# ==============================================================================

# Application Environment (development | production | test)
NODE_ENV=development

# Server Port
PORT=5000

# API Versioning Prefix
API_PREFIX=/api/v1

# CORS Allowed Origin (Frontend URL)
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Atlas Connection URI
# Example: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/agritech360?retryWrites=true&w=majority

# JWT (JSON Web Token) Configuration
JWT_SECRET=agritech360_super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=7d

# Password Hashing
BCRYPT_SALT_ROUNDS=10

# HTTP Request Logging (dev | combined | common | short | tiny)
LOG_FORMAT=dev
