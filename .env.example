# ==============================================================================
# AgriTech360 Frontend Environment Variables
# ==============================================================================
# Copy this file to .env in the project root:
#   cp .env.example .env
# ==============================================================================

# Backend API Root URL (Node.js + Express server)
# In development with local server: http://localhost:5000/api/v1
# In production: https://api.agritech360.internal/v1
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Master Mock vs Live Backend Switch
# Set to 'true' ONLY for local offline development (no backend required).
# MUST be 'false' in production — live backend and real data will be used.
# When absent, the app defaults to 'false' (live mode).
VITE_USE_MOCK_DATA=true

# Demo Mode — shows a visible "DEMO DATA" banner in the UI.
# Set to 'true' when running a presentation or evaluation demo with mock data.
# Must NOT be 'true' in production.
VITE_DEMO_MODE=false

# HTTP Request Timeout in milliseconds
VITE_API_TIMEOUT_MS=10000
