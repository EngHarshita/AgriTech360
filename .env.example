# ==============================================================================
# AgriTech360 Frontend Environment Variables
# ==============================================================================

# Backend API Root URL (Node.js + Express server)
# In development with local server: http://localhost:5000/api/v1
# In production: https://api.agritech360.internal/v1
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Master Mock vs Live Backend Switch
# Set to 'true' to use simulated ICAR data & offline farmer mock data.
# Set to 'false' to route all 7 modules to the live Express + MongoDB backend.
VITE_USE_MOCK_DATA=true

# HTTP Request Timeout in milliseconds
VITE_API_TIMEOUT_MS=10000

# OpenWeather API Key (optional proxy via backend)
VITE_OPENWEATHER_API_KEY=
