{
  "name": "agritech360",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node --max-old-space-size=4096 ./node_modules/typescript/bin/tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "server:dev": "npm --prefix server run dev",
    "server:build": "npm --prefix server run build",
    "ml:dev": "node scripts/start_ml.cjs",
    "dev:all": "concurrently -k -n \"FRONTEND,BACKEND,ML-ENGINE\" -c \"cyan.bold,green.bold,yellow.bold\" \"npm run dev\" \"npm run server:dev\" \"npm run ml:dev\"",
    "test:server": "npm --prefix server run test",
    "test:ml": "node scripts/start_ml.cjs test_ml_service.py",
    "test": "npm run test:server && npm run test:ml"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.1",
    "axios": "^1.20.0",
    "lucide-react": "^1.52.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.6",
    "oxlint": "^1.81.0",
    "postcss": "^8.5.29",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
